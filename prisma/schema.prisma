// Parrot LMS — Prisma schema
// Database: MongoDB (requires a replica set, even for a single local node,
// because Prisma uses multi-document transactions for progress recalculation).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonType {
  ARTICLE
  VIDEO
  QUIZ
  DOCUMENT
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
  // Set when the purchase behind the enrollment is refunded/charged back
  // (see /api/webhooks/gohighlevel/refund) or an admin pulls access. The
  // account survives; course content turns 403 (see requireCourseAccess).
  REVOKED
}

enum PaymentStatus {
  SUCCEEDED
  REFUNDED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  COURSE_UPDATE
  ENROLLMENT
  ACHIEVEMENT
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

enum ActivityType {
  LESSON_STARTED
  LESSON_COMPLETED
  QUIZ_COMPLETED
  COURSE_ENROLLED
  COURSE_COMPLETED
}

// ---------------------------------------------------------------------------
// Auth.js models (Prisma Mongo adapter contract)
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Single-use link issued right after a verified GoHighLevel course purchase
/// (see api/webhooks/gohighlevel/purchase) and emailed to the buyer so they
/// can set a username and password for the account and log in on Parrot LMS.
/// Never issued for a user who already has a password -- they just log in
/// normally.
model PasswordSetupToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One processed GoHighLevel "order paid" webhook. The unique ghlTransactionId
/// is the idempotency key: a redelivered webhook for the same transaction finds
/// this row and returns success without provisioning a second time. Created
/// LAST in the provisioning flow, so it doubles as the "fully processed"
/// marker -- if provisioning dies halfway, no Payment row exists and the
/// redelivery safely re-runs the (individually idempotent) earlier steps.
/// Never stores card data -- GoHighLevel/Stripe hold that; this is bookkeeping.
model Payment {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  userId           String        @db.ObjectId
  // GHL transaction/payment/order id from the webhook's Custom Data. When the
  // workflow doesn't send one, a synthetic `no-txn:<uuid>` key is stored
  // instead (idempotency is then best-effort -- see access.service).
  ghlTransactionId String        @unique
  ghlContactId     String?
  ghlProductId     String?
  ghlLocationId    String?
  // Informational echo of what GHL reported; GHL/Stripe stay the money
  // source of truth.
  amountCents      Int?
  currency         String?
  status           PaymentStatus @default(SUCCEEDED)
  // Course slugs this payment unlocked -- what a refund of this transaction revokes.
  courseSlugs      String[]
  // True when the account had no password at purchase time, so the buyer was
  // sent an account-setup link (PasswordSetupToken) instead of the login page.
  issuedCredentials Boolean      @default(false)
  processedAt      DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailLogs EmailLog[]

  @@index([userId])
}

/// Tracks every credentials-email handoff to GoHighLevel, which owns email
/// delivery (contact custom fields + trigger tag fire the GHL workflow that
/// sends the message). SENT = handed to GHL; FAILED keeps the account and
/// enrollment valid -- the handoff is retried when the webhook is
/// redelivered. Never stores the plaintext password.
model EmailLog {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?     @db.ObjectId
  paymentId String?     @db.ObjectId
  to        String
  subject   String
  status    EmailStatus @default(PENDING)
  // Provider/transport error message for FAILED sends (never contains secrets).
  error     String?
  sentAt    DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([paymentId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String    @unique
  // Optional login handle, stored lowercase; chosen on /activate after a
  // purchase. Not @unique for the same reason as wordpressUserId below --
  // uniqueness is enforced in activation.service.ts instead.
  username      String?
  emailVerified DateTime?
  // bcrypt hash. Null for accounts that only ever signed in via an OAuth
  // provider (Google/GitHub) -- those never set a local password.
  password      String?
  // Legacy link to the removed WordPress/WooCommerce bridge. No longer
  // written by the app; kept nullable so old rows stay valid. Not @unique:
  // every local account now omits it, and MongoDB's unique index treats a
  // missing field as null, so more than one account without it would
  // otherwise collide on a standard (non-sparse) unique index.
  wordpressUserId Int?
  image         String?
  bio           String?
  role          Role      @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  passwordSetupTokens PasswordSetupToken[]
  payments  Payment[]
  emailLogs EmailLog[]

  coursesTaught Course[]         @relation("InstructorCourses")
  enrollments   Enrollment[]
  progress      Progress[]
  quizAttempts  QuizAttempt[]
  ratings       CourseRating[]
  media         Media[]
  notifications Notification[]
  activity      LearningActivity[]

  @@index([role])
  @@index([username])
}

// ---------------------------------------------------------------------------
// Courses
// ---------------------------------------------------------------------------

model CourseCategory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  courses Course[]
}

model Course {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  slug         String       @unique
  description  String
  thumbnail    String?
  categoryId   String?      @db.ObjectId
  level        CourseLevel  @default(BEGINNER)
  status       CourseStatus @default(DRAFT)
  instructorId String       @db.ObjectId
  // Display price in cents, USD. 0 means free -- the student can self-enroll
  // with one click. Keep in sync with the real price on the GoHighLevel
  // checkout below; this field is informational only, GoHighLevel is the
  // actual source of truth for what's charged.
  priceCents   Int          @default(0)
  // The GoHighLevel checkout page (funnel/order form/payment link) that sells
  // this course. Required for a paid course's "Buy" button to have anywhere
  // to send the buyer -- null shows "not yet available for purchase" instead.
  ghlCheckoutUrl String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  category   CourseCategory? @relation(fields: [categoryId], references: [id])
  instructor User            @relation("InstructorCourses", fields: [instructorId], references: [id])

  modules      Module[]
  enrollments  Enrollment[]
  progress     Progress[]
  ratings      CourseRating[]
  activity     LearningActivity[]

  @@index([status])
  @@index([instructorId])
  @@index([categoryId])
}

model Module {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  courseId    String   @db.ObjectId
  title       String
  description String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, order])
}

model Lesson {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  moduleId    String     @db.ObjectId
  // Denormalized for fast lookups/aggregations without a $lookup hop through Module.
  courseId    String     @db.ObjectId
  title       String
  slug        String
  description String?
  content     String?
  videoUrl    String?
  duration    Int?       @default(0)
  order       Int
  type        LessonType @default(ARTICLE)
  published   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  module   Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quiz     Quiz?
  progress Progress[]
  activity LearningActivity[]

  @@index([moduleId, order])
  @@index([courseId])
}

// ---------------------------------------------------------------------------
// Enrollments & Progress
// ---------------------------------------------------------------------------

model Enrollment {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  userId          String           @db.ObjectId
  courseId        String           @db.ObjectId
  status          EnrollmentStatus @default(ACTIVE)
  // Denormalized snapshot maintained by the progress service — never trust the client for this value.
  progressPercent Float            @default(0)
  enrolledAt      DateTime         @default(now())
  completedAt     DateTime?
  lastAccessedAt  DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([userId, status])
}

model Progress {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  courseId        String    @db.ObjectId
  lessonId        String    @db.ObjectId
  completed       Boolean   @default(false)
  progressPercent Float     @default(0)
  lastPosition    Int       @default(0)
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, courseId])
}

// ---------------------------------------------------------------------------
// Quizzes
// ---------------------------------------------------------------------------

model Quiz {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  lessonId  String   @unique @db.ObjectId
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id       String       @id @default(auto()) @map("_id") @db.ObjectId
  quizId   String       @db.ObjectId
  question String
  type     QuestionType @default(SINGLE_CHOICE)
  order    Int          @default(0)

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([quizId, order])
}

model Answer {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  questionId String  @db.ObjectId
  answer     String
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuizAttempt {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  quizId      String   @db.ObjectId
  score       Float
  // { [questionId]: string[] } — selected answer ids per question, kept for attempt review.
  answers     Json?
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
}

// ---------------------------------------------------------------------------
// Ratings, Media, Notifications, Activity
// ---------------------------------------------------------------------------

model CourseRating {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  courseId  String   @db.ObjectId
  rating    Int
  review    String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model Media {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  fileName  String
  fileUrl   String
  type      MediaType
  size      Int
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  title     String
  message   String
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

/// Append-only log used to compute learning streaks and activity-over-time charts
/// without scanning the full Progress collection on every dashboard load.
model LearningActivity {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  userId       String       @db.ObjectId
  courseId     String?      @db.ObjectId
  lessonId     String?      @db.ObjectId
  type         ActivityType
  minutesSpent Int          @default(0)
  occurredAt   DateTime     @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, occurredAt])
}
