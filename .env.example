# MongoDB connection string. Must point at a replica set — Prisma uses
# multi-document transactions (e.g. recalculating course progress) which
# MongoDB only supports on a replica set / mongos, even with a single node.
#
# Local dev (docker compose, see docker-compose.yml):
DATABASE_URL="mongodb://localhost:27017/parrot_lms?replicaSet=rs0&directConnection=true"
#
# MongoDB Atlas (free tier is already a replica set — no extra config needed):
# DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/parrot_lms?retryWrites=true&w=majority"

# Auth.js
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-with-a-32+-byte-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional OAuth providers (leave unset to only offer email/password login)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# Local media storage (default adapter). Files are written under /public/uploads.
MEDIA_STORAGE_DRIVER="local"

# course-platform-bridge WordPress plugin -- identity, passwords, checkout
# and course purchase access all live in WordPress/WooCommerce (see
# wordpress-plugin/course-platform-bridge/). Next.js never stores a
# password; the Credentials login form forwards email+password straight
# through to WORDPRESS_URL over this server-to-server API and never persists
# it. Define the matching COURSE_PLATFORM_BRIDGE_* constants in the
# WordPress site's wp-config.php -- the two API keys must be identical
# random 64-char hex strings on both sides (e.g. `openssl rand -hex 32`),
# and must be *different* from each other (one is server-to-server API auth,
# the other signs the WooCommerce -> Next.js webhook).
WORDPRESS_URL="http://127.0.0.1:8090"
WORDPRESS_BRIDGE_API_KEY="replace-with-a-64-char-hex-secret"
WORDPRESS_BRIDGE_WEBHOOK_SECRET="replace-with-a-different-64-char-hex-secret"
