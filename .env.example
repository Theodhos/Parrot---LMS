# MongoDB connection string. Must point at a replica set — Prisma uses
# multi-document transactions (e.g. recalculating course progress) which
# MongoDB only supports on a replica set / mongos, even with a single node.
#
# Local dev (docker compose, see docker-compose.yml):
DATABASE_URL="mongodb://localhost:27017/parrot_lms?replicaSet=rs0&directConnection=true"
#
# MongoDB Atlas (free tier is already a replica set — no extra config needed):
# DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/parrot_lms?retryWrites=true&w=majority"

# Auth.js
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-with-a-32+-byte-random-secret"
NEXTAUTH_URL="http://localhost:3010"

# Optional OAuth providers (leave unset to only offer email/password login)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# Local media storage (default adapter). Files are written under /public/uploads.
MEDIA_STORAGE_DRIVER="local"

# WordPress + WooCommerce -- the real purchase path for paid courses
# (Course.priceCents > 0). Checkout happens on your WordPress/WooCommerce
# site (see wordpress-plugin/course-platform-bridge/); after payment its
# order-received page redirects the buyer straight back here, to
# /activate (new buyer -- set a password) or /login (existing account).
# Free courses (priceCents === 0) skip this entirely and self-enroll with
# one click. Identity/passwords stay local (MongoDB) either way -- this
# bridge is purchase-only, not an auth provider.
#
# The two API keys must be identical random 64-char hex strings on both
# this app and the matching COURSE_PLATFORM_BRIDGE_* constants in the
# WordPress site's wp-config.php (e.g. `openssl rand -hex 32` for each),
# and must be *different* from each other (one is server-to-server API
# auth, the other signs the WooCommerce -> Next.js webhook/redirect calls).
WORDPRESS_URL="http://127.0.0.1:8090"
WORDPRESS_BRIDGE_API_KEY="replace-with-a-64-char-hex-secret"
WORDPRESS_BRIDGE_WEBHOOK_SECRET="replace-with-a-different-64-char-hex-secret"

# Stripe -- built and wired up (see src/features/payments/, src/lib/payments/,
# /api/webhooks/stripe) but not currently used by any button in the UI; the
# "Buy" button on a paid course links to WooCommerce instead (above). Set
# these only if you want to reconnect the Stripe Checkout path.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
