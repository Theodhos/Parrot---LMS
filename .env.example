# MongoDB connection string. Must point at a replica set — Prisma uses
# multi-document transactions (e.g. recalculating course progress) which
# MongoDB only supports on a replica set / mongos, even with a single node.
#
# Local dev (docker compose, see docker-compose.yml):
DATABASE_URL="mongodb://localhost:27017/parrot_lms?replicaSet=rs0&directConnection=true"
#
# MongoDB Atlas (free tier is already a replica set — no extra config needed):
# DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/parrot_lms?retryWrites=true&w=majority"

# Auth.js
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-with-a-32+-byte-random-secret"
NEXTAUTH_URL="http://localhost:3010"

# Optional OAuth providers (leave unset to only offer email/password login)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# Media storage. Without a Blob token, uploads are written under
# /public/uploads (local development only -- Vercel's disk is read-only).
# Uploaded photos/videos/documents are kept in their own MongoDB database,
# separate from the application data. By default: a database named
# "parrot_media" on the same cluster as DATABASE_URL. Both are optional.
# MEDIA_DATABASE_URL="mongodb+srv://USER:PASSWORD@other-cluster.mongodb.net/"
# MEDIA_DATABASE_NAME="parrot_media"
# Vercel Blob -- required on Vercel for uploading course videos and files.
# Added automatically when a PUBLIC Blob store is connected to the project
# (Vercel dashboard -> Storage -> Create -> Blob). When set, the browser
# uploads straight to Blob.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# GoHighLevel -- the real purchase path for paid courses
# (Course.priceCents > 0) AND the email delivery system. Checkout and payment
# happen on a GoHighLevel funnel/order form; a GoHighLevel workflow then calls
# /api/webhooks/gohighlevel/purchase, which (idempotently, keyed on the
# transaction id) creates the buyer's account from their checkout email (no
# password yet), enrolls them with lifetime access, records the payment, then
# writes a single-use account-setup link onto the GHL contact's custom field
# and adds a trigger tag -- a second GHL workflow reacts to that tag and
# emails the link, where the buyer chooses their own username and password.
# The app sends no email itself, and no password travels by email.
# A refund workflow calls /api/webhooks/gohighlevel/refund
# to revoke access. Free courses (priceCents === 0) skip all of this and
# self-enroll with one click.
#
# Shared secret both webhook workflows must send, as the
# `x-webhook-secret` header or a `secret` Custom Data field
# (e.g. `openssl rand -hex 32`).
GHL_WEBHOOK_SECRET="replace-with-a-64-char-hex-secret"
# REQUIRED for the access email: Private Integration token of the
# GoHighLevel sub-account, with the "View Contacts" and "Edit Contacts"
# scopes. Used to write the custom field + trigger tag below.
GHL_API_TOKEN="pit-..."
# Only used when a webhook arrives without a contact_id (the contact is then
# upserted by email inside this location).
# GHL_LOCATION_ID=""
#
# Contact custom field unique key (without the "contact." prefix) the email
# workflow merges: the buyer's setup link, or the login page for an account
# that already has a password. Only set it if your sub-account's key differs.
# GHL_LOGIN_URL_FIELD_KEY="course_login_url"
# Tags added after the field is written; each fires its email workflow.
# GHL_CREDENTIALS_TAG="course-credentials-ready"
# GHL_ACCESS_GRANTED_TAG="course-access-granted"
# GHL_PASSWORD_RESET_TAG="course-password-reset"

# WordPress + WooCommerce -- DORMANT. The plugin
# (wordpress-plugin/course-platform-bridge/), the local dev setup script
# (scripts/setup-local-wordpress.sh) and the bridge client
# (src/features/auth/services/wordpress-bridge.service.ts) are kept in the
# repo, but nothing in the app's logic calls them and there is no
# /api/webhooks/woocommerce route anymore -- GoHighLevel (above) is the only
# purchase path. These values are read by nothing at runtime; they only keep
# the WordPress side's configuration on record (they match the
# COURSE_PLATFORM_BRIDGE_* constants in the WordPress site's wp-config.php).
# WORDPRESS_URL="http://127.0.0.1:8090"
# WORDPRESS_BRIDGE_API_KEY="replace-with-a-64-char-hex-secret"
# WORDPRESS_BRIDGE_WEBHOOK_SECRET="replace-with-a-different-64-char-hex-secret"

# Stripe -- built and wired up (see src/features/payments/, src/lib/payments/,
# /api/webhooks/stripe) but not currently used by any button in the UI; the
# "Buy" button on a paid course links to GoHighLevel instead (above). Set
# these only if you want to reconnect the Stripe Checkout path.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
