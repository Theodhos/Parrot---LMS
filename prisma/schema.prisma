// Parrot LMS — Prisma schema
// Database: MongoDB (requires a replica set, even for a single local node,
// because Prisma uses multi-document transactions for progress recalculation).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonType {
  ARTICLE
  VIDEO
  QUIZ
  DOCUMENT
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum AccessStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  COURSE_UPDATE
  ENROLLMENT
  ACHIEVEMENT
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

enum ActivityType {
  LESSON_STARTED
  LESSON_COMPLETED
  QUIZ_COMPLETED
  COURSE_ENROLLED
  COURSE_COMPLETED
}

// ---------------------------------------------------------------------------
// Auth.js models (Prisma Mongo adapter contract)
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String    @unique
  emailVerified DateTime?
  // Identity + password lives entirely in WordPress -- this is the stable
  // link back to it. Never store a password here; see
  // features/auth/services/wordpress-bridge.service.ts.
  wordpressUserId Int?    @unique
  image         String?
  bio           String?
  role          Role      @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  coursesTaught Course[]         @relation("InstructorCourses")
  enrollments   Enrollment[]
  progress      Progress[]
  quizAttempts  QuizAttempt[]
  ratings       CourseRating[]
  media         Media[]
  notifications Notification[]
  activity      LearningActivity[]

  @@index([role])
}

// ---------------------------------------------------------------------------
// Courses
// ---------------------------------------------------------------------------

model CourseCategory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  courses Course[]
}

model Course {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  slug         String       @unique
  description  String
  thumbnail    String?
  categoryId   String?      @db.ObjectId
  level        CourseLevel  @default(BEGINNER)
  status       CourseStatus @default(DRAFT)
  instructorId String       @db.ObjectId
  // The WooCommerce product that grants access to this course (set to that
  // product's _course_id meta on the WordPress side). Lets the "buy" CTA
  // deep-link straight to checkout instead of a generic store page.
  woocommerceProductId Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  category   CourseCategory? @relation(fields: [categoryId], references: [id])
  instructor User            @relation("InstructorCourses", fields: [instructorId], references: [id])

  modules      Module[]
  enrollments  Enrollment[]
  progress     Progress[]
  ratings      CourseRating[]
  activity     LearningActivity[]
  courseAccess CourseAccess[]

  @@index([status])
  @@index([instructorId])
  @@index([categoryId])
}

model Module {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  courseId    String   @db.ObjectId
  title       String
  description String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, order])
}

model Lesson {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  moduleId    String     @db.ObjectId
  // Denormalized for fast lookups/aggregations without a $lookup hop through Module.
  courseId    String     @db.ObjectId
  title       String
  slug        String
  description String?
  content     String?
  videoUrl    String?
  duration    Int?       @default(0)
  order       Int
  type        LessonType @default(ARTICLE)
  published   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  module   Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quiz     Quiz?
  progress Progress[]
  activity LearningActivity[]

  @@index([moduleId, order])
  @@index([courseId])
}

// ---------------------------------------------------------------------------
// WordPress/WooCommerce purchase-access cache
// ---------------------------------------------------------------------------

/// A fast, idempotent cache of "has this WordPress user purchased this
/// course" -- written ONLY by the signed webhook handler
/// (api/webhooks/woocommerce), never by client input. WordPress/WooCommerce
/// remains the authority on the underlying purchase; this table exists so
/// access checks are a single indexed read instead of a call out to
/// WordPress on every request. Keyed by wordpressUserId (not the local
/// User.id) because a purchase can be synced before the buyer's first
/// Next.js login.
model CourseAccess {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  wordpressUserId  Int
  courseId         String       @db.ObjectId
  courseSlug       String
  woocommerceProductId Int
  woocommerceOrderId   Int
  status           AccessStatus @default(ACTIVE)
  grantedAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([wordpressUserId, courseId])
  @@index([courseId])
}

// ---------------------------------------------------------------------------
// Enrollments & Progress
// ---------------------------------------------------------------------------

model Enrollment {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  userId          String           @db.ObjectId
  courseId        String           @db.ObjectId
  status          EnrollmentStatus @default(ACTIVE)
  // Denormalized snapshot maintained by the progress service — never trust the client for this value.
  progressPercent Float            @default(0)
  enrolledAt      DateTime         @default(now())
  completedAt     DateTime?
  lastAccessedAt  DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([userId, status])
}

model Progress {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  courseId        String    @db.ObjectId
  lessonId        String    @db.ObjectId
  completed       Boolean   @default(false)
  progressPercent Float     @default(0)
  lastPosition    Int       @default(0)
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, courseId])
}

// ---------------------------------------------------------------------------
// Quizzes
// ---------------------------------------------------------------------------

model Quiz {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  lessonId  String   @unique @db.ObjectId
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id       String       @id @default(auto()) @map("_id") @db.ObjectId
  quizId   String       @db.ObjectId
  question String
  type     QuestionType @default(SINGLE_CHOICE)
  order    Int          @default(0)

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([quizId, order])
}

model Answer {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  questionId String  @db.ObjectId
  answer     String
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuizAttempt {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  quizId      String   @db.ObjectId
  score       Float
  // { [questionId]: string[] } — selected answer ids per question, kept for attempt review.
  answers     Json?
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
}

// ---------------------------------------------------------------------------
// Ratings, Media, Notifications, Activity
// ---------------------------------------------------------------------------

model CourseRating {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  courseId  String   @db.ObjectId
  rating    Int
  review    String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model Media {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  fileName  String
  fileUrl   String
  type      MediaType
  size      Int
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  title     String
  message   String
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

/// Append-only log used to compute learning streaks and activity-over-time charts
/// without scanning the full Progress collection on every dashboard load.
model LearningActivity {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  userId       String       @db.ObjectId
  courseId     String?      @db.ObjectId
  lessonId     String?      @db.ObjectId
  type         ActivityType
  minutesSpent Int          @default(0)
  occurredAt   DateTime     @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, occurredAt])
}
